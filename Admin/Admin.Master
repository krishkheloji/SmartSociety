<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="SocietyManagement.Admin.Admin" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Society Management</title>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-color: #2563eb;
            --primary-dark: #1e40af;
            --secondary-color: #64748b;
            --sidebar-bg: #1e293b;
            --sidebar-hover: #334155;
            --content-bg: #f8fafc;
            --border-color: #e2e8f0;
            --text-dark: #0f172a;
            --text-light: #64748b;
            --white: #ffffff;
            --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
            --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1);
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--content-bg);
            color: var(--text-dark);
            overflow-x: hidden;
        }

        /* Sidebar Styles */
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 280px;
            height: 100vh;
            background: var(--sidebar-bg);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1000;
            overflow-y: auto;
            box-shadow: var(--shadow-lg);
        }

            .sidebar.collapsed {
                width: 70px;
            }

            .sidebar::-webkit-scrollbar {
                width: 6px;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background: var(--sidebar-hover);
                border-radius: 3px;
            }

        /* Logo Section */
        .logo-section {
            padding: 24px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: var(--primary-color);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            flex-shrink: 0;
        }

        .logo-text {
            color: white;
            font-size: 18px;
            font-weight: 700;
            white-space: nowrap;
            transition: opacity 0.3s;
        }

        .sidebar.collapsed .logo-text {
            opacity: 0;
            width: 0;
        }

        /* Navigation */
        .nav-section {
            padding: 20px 0;
        }

        .nav-item {
            margin: 0 12px 4px;
        }

        .nav-link-custom {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            color: #cbd5e1;
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.2s;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
        }

            .nav-link-custom:hover {
                background: var(--sidebar-hover);
                color: white;
            }

            .nav-link-custom.active {
                background: var(--primary-color);
                color: white;
            }

        .nav-icon {
            width: 20px;
            margin-right: 12px;
            text-align: center;
            flex-shrink: 0;
        }

        .sidebar.collapsed .nav-icon {
            margin-right: 0;
        }

        .nav-text {
            white-space: nowrap;
            transition: opacity 0.3s;
        }

        .sidebar.collapsed .nav-text {
            opacity: 0;
            width: 0;
        }

        .dropdown-arrow {
            margin-left: auto;
            transition: transform 0.3s;
            font-size: 12px;
        }

        .sidebar.collapsed .dropdown-arrow {
            opacity: 0;
        }

        .nav-link-custom.expanded .dropdown-arrow {
            transform: rotate(90deg);
        }

        /* Submenu */
        .submenu {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
        }

            .submenu.show {
                max-height: 500px;
            }

        .submenu-item {
            padding: 8px 16px 8px 48px;
            color: #94a3b8;
            text-decoration: none;
            display: block;
            font-size: 13px;
            border-radius: 6px;
            margin: 2px 12px;
            transition: all 0.2s;
        }

        .sidebar.collapsed .submenu-item {
            padding-left: 16px;
        }

        .submenu-item:hover {
            background: var(--sidebar-hover);
            color: white;
        }

        /* Top Header */
        .top-header {
            position: fixed;
            top: 0;
            left: 280px;
            right: 0;
            height: 70px;
            background: var(--white);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            padding: 0 32px;
            transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 999;
            box-shadow: var(--shadow);
        }

        .sidebar.collapsed + .top-header {
            left: 70px;
        }

        .toggle-btn {
            width: 40px;
            height: 40px;
            border: none;
            background: var(--content-bg);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
            color: var(--text-dark);
        }

            .toggle-btn:hover {
                background: var(--border-color);
            }

        .header-right {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 16px;
            background: var(--content-bg);
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.2s;
        }

            .user-profile:hover {
                background: var(--border-color);
            }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--primary-color);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 14px;
        }

        .user-name {
            font-weight: 600;
            font-size: 14px;
            color: var(--text-dark);
        }

        /* Main Content */
        .main-content {
            margin-left: 280px;
            margin-top: 70px;
            padding: 32px;
            transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            min-height: calc(100vh - 70px);
        }

        .sidebar.collapsed ~ .main-content {
            margin-left: 70px;
        }

        /* Cards */
        .card {
            background: white;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow);
            transition: all 0.2s;
        }

            .card:hover {
                box-shadow: var(--shadow-lg);
            }

        /* Responsive */
        @media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.mobile-open {
                    transform: translateX(0);
                }

            .top-header {
                left: 0 !important;
            }

            .main-content {
                margin-left: 0 !important;
            }

            .user-name {
                display: none;
            }
        }

        /* Overlay for mobile */
        .overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
        }

            .overlay.show {
                display: block;
            }

        /* Logout Button */
        .logout-btn {
            margin: 20px 12px;
            padding: 12px 16px;
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
            border: none;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 14px;
            font-weight: 500;
            width: calc(100% - 24px);
        }

            .logout-btn:hover {
                background: #ef4444;
                color: white;
            }

        .sidebar.collapsed .logout-btn {
            justify-content: center;
        }

            .sidebar.collapsed .logout-btn span {
                display: none;
            }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Sidebar -->
        <div class="sidebar" id="sidebar">
            <div class="logo-section">
                <div class="logo-icon">
                    <i class="fas fa-building"></i>
                </div>
                <div class="logo-text">Society Portal</div>
            </div>

            <div class="nav-section">
                <!-- Dashboard -->
                <div class="nav-item">
                    <a href="~/Admin/Dashboard.aspx" runat="server" class="nav-link-custom">
                        <i class="fas fa-home nav-icon"></i>
                        <span class="nav-text">Dashboard</span>
                    </a>
                </div>

                <!-- Society -->
                <div class="nav-item">
                    <div class="nav-link-custom" onclick="toggleSubmenu(this)">
                        <i class="fas fa-city nav-icon"></i>
                        <span class="nav-text">Society</span>
                        <i class="fas fa-chevron-right dropdown-arrow"></i>
                    </div>
                    <div class="submenu">
                        <a href="~/Admin/Society/ManageSociety.aspx" runat="server" class="submenu-item">Manage Society</a>
                        <a href="~/Admin/Society/ManageBuilding.aspx" runat="server" class="submenu-item">Manage Building</a>
                        <a href="~/Admin/Society/ManageUnit.aspx" runat="server" class="submenu-item">Manage Unit</a>
                    </div>
                </div>

                <!-- Members -->
                <div class="nav-item">
                    <div class="nav-link-custom" onclick="toggleSubmenu(this)">
                        <i class="fas fa-users nav-icon"></i>
                        <span class="nav-text">Members</span>
                        <i class="fas fa-chevron-right dropdown-arrow"></i>
                    </div>
                    <div class="submenu">
                        <a href="~/Admin/Member/ManageMember.aspx" runat="server" class="submenu-item">Manage Members</a>
                        <a href="~/Admin/Member/AddMember.aspx" runat="server" class="submenu-item">Add Member</a>
                        <a href="~/Admin/Member/CreateAccount.aspx" runat="server" class="submenu-item">Create Account</a>
                    </div>
                </div>

                <!-- Finance -->
                <div class="nav-item">
                    <div class="nav-link-custom" onclick="toggleSubmenu(this)">
                        <i class="fas fa-wallet nav-icon"></i>
                        <span class="nav-text">Finance</span>
                        <i class="fas fa-chevron-right dropdown-arrow"></i>
                    </div>
                    <div class="submenu">
                        <a href="~/Admin/Finance/MaintenanceBill.aspx" runat="server" class="submenu-item">Maintenance Bill</a>
                        <a href="~/Admin/Finance/PaymentRecords.aspx" runat="server" class="submenu-item">Payment Records</a>
                        <a href="~/Admin/Finance/GenerateLightBill.aspx" runat="server" class="submenu-item">Generate Light Bill</a>
                    </div>
                </div>

                <!-- Expenses -->
                <div class="nav-item">
                    <a href="~/Admin/Expenses/ManageExpenses.aspx" runat="server" class="nav-link-custom">
                        <i class="fas fa-receipt nav-icon"></i>
                        <span class="nav-text">Expenses</span>
                    </a>
                </div>

                <!-- Parking -->
                <div class="nav-item">
                    <div class="nav-link-custom" onclick="toggleSubmenu(this)">
                        <i class="fas fa-parking nav-icon"></i>
                        <span class="nav-text">Parking</span>
                        <i class="fas fa-chevron-right dropdown-arrow"></i>
                    </div>
                    <div class="submenu">
                        <a href="~/Admin/Parking/ManageParkingSlots.aspx" runat="server" class="submenu-item">Manage Slots</a>
                        <a href="~/Admin/Parking/AssignVehicle.aspx" runat="server" class="submenu-item">Assign Vehicle</a>
                    </div>
                </div>

                <!-- Complaints -->
                <div class="nav-item">
                    <div class="nav-link-custom" onclick="toggleSubmenu(this)">
                        <i class="fas fa-exclamation-circle nav-icon"></i>
                        <span class="nav-text">Complaints</span>
                        <i class="fas fa-chevron-right dropdown-arrow"></i>
                    </div>
                    <div class="submenu">
                        <a href="~/Admin/Complaints/AddComplaints.aspx" runat="server" class="submenu-item">Add Complaint</a>
                        <a href="~/Admin/Complaints/ComplaintDetails.aspx" runat="server" class="submenu-item">View All</a>
                    </div>
                </div>

                <!-- Announcements -->
                <div class="nav-item">
                    <a href="~/Admin/ManageAnnouncements.aspx" runat="server" class="nav-link-custom">
                        <i class="fas fa-bullhorn nav-icon"></i>
                        <span class="nav-text">Announcements</span>
                    </a>
                </div>

                <!-- Amenities -->
                <div class="nav-item">
                    <div class="nav-link-custom" onclick="toggleSubmenu(this)">
                        <i class="fas fa-swimming-pool nav-icon"></i>
                        <span class="nav-text">Amenities</span>
                        <i class="fas fa-chevron-right dropdown-arrow"></i>
                    </div>
                    <div class="submenu">
                        <a href="~/Admin/Amenities/ManageAmenities.aspx" runat="server" class="submenu-item">Manage Amenities</a>
                        <a href="~/Admin/Amenities/ApproveBookings.aspx" runat="server" class="submenu-item">Approve Bookings</a>
                        <a href="~/Admin/Amenities/ViewAllBookings.aspx" runat="server" class="submenu-item">All Bookings</a>
                    </div>
                </div>

                <!-- Security -->
                <div class="nav-item">
                    <div class="nav-link-custom" onclick="toggleSubmenu(this)">
                        <i class="fas fa-shield-alt nav-icon"></i>
                        <span class="nav-text">Security</span>
                        <i class="fas fa-chevron-right dropdown-arrow"></i>
                    </div>
                    <div class="submenu">
                        <a href="~/Admin/Security/VisitorsLog.aspx" runat="server" class="submenu-item">Visitor Log</a>
                        <a href="~/Admin/Security/VisitorsEntry.aspx" runat="server" class="submenu-item">Add Entry</a>
                        <a href="~/Admin/Security/VisitorsCheckOut.aspx" runat="server" class="submenu-item">Checkout</a>
                    </div>
                </div>

                <!-- Meters -->
                <div class="nav-item">
                    <div class="nav-link-custom" onclick="toggleSubmenu(this)">
                        <i class="fas fa-tachometer-alt nav-icon"></i>
                        <span class="nav-text">Meters</span>
                        <i class="fas fa-chevron-right dropdown-arrow"></i>
                    </div>
                    <div class="submenu">
                        <a href="~/Admin/Meters/AddMeterReading.aspx" runat="server" class="submenu-item">Add Reading</a>
                        <a href="~/Admin/Meters/ViewMeterReadings.aspx" runat="server" class="submenu-item">View Readings</a>
                    </div>
                </div>

                <!-- Vendors -->
                <div class="nav-item">
                    <a href="~/Admin/Vendors/Vendors.aspx" runat="server" class="nav-link-custom">
                        <i class="fas fa-truck nav-icon"></i>
                        <span class="nav-text">Vendors</span>
                    </a>
                </div>
            </div>

            <!-- Logout Button -->
            <%-- <button class="logout-btn" onclick="window.location.href='~/Logout.aspx'; return false;">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </button>--%>
            <a href="~/Logout.aspx" runat="server" class="logout-btn">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </a>
        </div>

        <!-- Mobile Overlay -->
        <div class="overlay" id="overlay" onclick="toggleMobileSidebar()"></div>

        <!-- Top Header -->
        <div class="top-header">
            <button class="toggle-btn" onclick="toggleSidebar()">
                <i class="fas fa-bars"></i>
            </button>

            <div class="header-right">
                <div class="user-profile">
                    <div class="user-avatar">
                        <asp:Label ID="lblAdminInitial" runat="server" Text="A"></asp:Label>
                    </div>
                    <div class="user-name">
                        <asp:Label ID="lblAdminName" runat="server" Text="Admin User"></asp:Label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const isMobile = window.innerWidth <= 768;

            if (isMobile) {
                toggleMobileSidebar();
            } else {
                sidebar.classList.toggle('collapsed');
                localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('collapsed'));
            }
        }

        function toggleMobileSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('overlay');
            sidebar.classList.toggle('mobile-open');
            overlay.classList.toggle('show');
        }

        function toggleSubmenu(element) {
            const submenu = element.nextElementSibling;
            const isExpanded = submenu.classList.contains('show');

            // Close all other submenus
            document.querySelectorAll('.submenu').forEach(sub => {
                sub.classList.remove('show');
            });
            document.querySelectorAll('.nav-link-custom').forEach(link => {
                link.classList.remove('expanded');
            });

            // Toggle current submenu
            if (!isExpanded) {
                submenu.classList.add('show');
                element.classList.add('expanded');
            }
        }

        // Restore sidebar state on load
        window.addEventListener('load', function () {
            const sidebar = document.getElementById('sidebar');
            const collapsed = localStorage.getItem('sidebarCollapsed') === 'true';
            if (collapsed && window.innerWidth > 768) {
                sidebar.classList.add('collapsed');
            }

            // Set active link
            const currentPath = window.location.pathname;
            document.querySelectorAll('.nav-link-custom, .submenu-item').forEach(link => {
                if (link.href && link.href.includes(currentPath)) {
                    link.classList.add('active');
                    // Expand parent submenu if exists
                    const submenu = link.closest('.submenu');
                    if (submenu) {
                        submenu.classList.add('show');
                        submenu.previousElementSibling.classList.add('expanded');
                    }
                }
            });
        });

        // Close mobile sidebar on window resize
        window.addEventListener('resize', function () {
            if (window.innerWidth > 768) {
                document.getElementById('sidebar').classList.remove('mobile-open');
                document.getElementById('overlay').classList.remove('show');
            }
        });
    </script>
</body>
</html>
